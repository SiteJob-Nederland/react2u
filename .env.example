# Lokale ontwikkelomgeving. Kopieer naar .env en vul de wachtwoorden.
# .env staat in .gitignore en hoort daar te blijven.
#
# Deze wachtwoorden zijn UITSLUITEND lokaal. Gebruik ze nooit op staging of productie.

COMPOSE_PROJECT_NAME=react2u_local
WORDPRESS_PORT=8103

WORDPRESS_DB_NAME=react2u_wordpress
WORDPRESS_DB_USER=react2u_local
WORDPRESS_DB_PASSWORD=verander-dit-lokaal
MARIADB_ROOT_PASSWORD=verander-dit-ook-lokaal

WORDPRESS_ADMIN_USER=kas
WORDPRESS_ADMIN_PASSWORD=verander-dit-lokaal
WORDPRESS_ADMIN_EMAIL=info@sitejob.nl

# Waar de QA-scripts naartoe kijken. Overschrijf per commando voor staging.
SITE_URL=http://127.0.0.1:8103/
